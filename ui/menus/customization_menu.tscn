text = "Unlocked Roster"

[node name="RosterScroll" type="ScrollContainer" parent="Content/Columns/Left"]
layout_mode = 2
size_flags_vertical = 3

[node name="RosterList" type="VBoxContainer" parent="Content/Columns/Left/RosterScroll"]
