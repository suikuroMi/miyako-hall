[gd_scene format=3]

[ext_resource type="Script" path="res://ui/menus/gacha_menu.gd" id="1_gacha"]
[ext_resource type="Texture2D" path="res://assets/tileset/TORII.png" id="2_art"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_bg"]
bg_color = Color(0.08, 0.08, 0.12, 0.95)
border_width_left = 3
border_width_top = 3
border_width_right = 3
border_width_bottom = 3
border_color = Color(0.7, 0.4, 0.6, 0.9)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_overlay"]
bg_color = Color(0.05, 0.05, 0.08, 0.98)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(1.0, 0.8, 0.3, 0.9)
corner_radius_top_left = 12
corner_radius_top_right = 12
corner_radius_bottom_right = 12
corner_radius_bottom_left = 12

[node name="GachaMenu" type="PanelContainer"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -400.0
offset_top = -260.0
offset_right = 400.0
offset_bottom = 260.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_bg")
script = ExtResource("1_gacha")

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Header" type="VBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="BannerTitle" type="Label" parent="Content/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "🌸 Kamikitakuni Gathering Banner"
horizontal_alignment = 1

[node name="BannerDesc" type="Label" parent="Content/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.75, 0.85, 1)
theme_override_font_sizes/font_size = 16
text = "Summon venerable Holomembers and sacred spiritual arms!"
horizontal_alignment = 1

[node name="CoinsLabel" type="Label" parent="Content/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(1.0, 0.85, 0.3, 1)
theme_override_font_sizes/font_size = 20
text = "🪙 Shrine Coins: 600"
horizontal_alignment = 1

[node name="BannerPreview" type="CenterContainer" parent="Content"]
layout_mode = 2
size_flags_vertical = 3

[node name="BannerArt" type="TextureRect" parent="Content/BannerPreview"]
custom_minimum_size = Vector2(300, 150)
layout_mode = 2
texture = ExtResource("2_art")
expand_mode = 1
stretch_mode = 5

[node name="Actions" type="HBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 20
alignment = 1

[node name="SinglePullButton" type="Button" parent="Content/Actions"]
custom_minimum_size = Vector2(200, 50)
layout_mode = 2
text = "Summon x1 (100 🪙)"

[node name="MultiPullButton" type="Button" parent="Content/Actions"]
custom_minimum_size = Vector2(200, 50)
layout_mode = 2
text = "Summon x10 (1000 🪙)"

[node name="CloseButton" type="Button" parent="Content/Actions"]
custom_minimum_size = Vector2(120, 50)
layout_mode = 2
text = "Close (G)"

[node name="ResultsOverlay" type="PanelContainer" parent="."]
visible = false
layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_overlay")

[node name="ResultsVBox" type="VBoxContainer" parent="ResultsOverlay"]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="ResultsOverlay/ResultsVBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 26
text = "✨ Summon Results ✨"
horizontal_alignment = 1

[node name="Scroll" type="ScrollContainer" parent="ResultsOverlay/ResultsVBox"]
layout_mode = 2
size_flags_vertical = 3

[node name="ResultsList" type="VBoxContainer" parent="ResultsOverlay/ResultsVBox/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="ClaimButton" type="Button" parent="ResultsOverlay/ResultsVBox"]
custom_minimum_size = Vector2(160, 44)
layout_mode = 2
size_flags_horizontal = 4
text = "Claim All"
