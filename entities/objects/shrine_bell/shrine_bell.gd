# shrine_bell.gd
# Sacred Shrine Bell (Bonshō) in Kamikitakuni Shrine hub.
# Ringing the bell provides options to:
#   1. Reset to peaceful Daylight & restore full party HP
#   2. Trigger the Midnight Stigmata Siege Defense Raid (3-wave battle for massive rewards)
#   3. Claim accumulated Idle Faith from rescued wandering souls

class_name ShrineBell
extends Node2D

@onready var interactable = get_node_or_null("InteractableComponent")
@onready var sprite: Sprite2D = $Sprite2D

const CHASER_SCENE: PackedScene = preload("res://entities/enemy/basic_chaser/basic_chaser.tscn")

var _is_ringing: bool = false
var _siege_wave: int = 0
var _siege_alive_enemies: int = 0

func _ready() -> void:
	if interactable:
		interactable.interacted.connect(_on_bell_interacted)

func _on_bell_interacted(_player: Node2D) -> void:
	if _is_ringing:
		return
	_is_ringing = true

	# Bell chime audio & tremor
	if AudioManager:
		AudioManager.play_sfx("purified")
	if CameraManager:
		CameraManager.shake(8.0, 0.3)

	# Gentle wobble tween on bell sprite
	if sprite:
		var tw = create_tween()
		tw.tween_property(sprite, "rotation_degrees", 8.0, 0.08)
		tw.tween_property(sprite, "rotation_degrees", -8.0, 0.08)
		tw.tween_property(sprite, "rotation_degrees", 4.0, 0.06)
		tw.tween_property(sprite, "rotation_degrees", 0.0, 0.06)

	if GameManager and GameManager.is_shrine_siege_active:
		_show_dialogue("⛩️ Midnight Siege in Progress!", "Corrupted Stigmatas are currently invading the Torii gate! Defend the shrine!")
		_is_ringing = false
		return

	# Show choices modal or options dialogue
	_show_bell_menu()

func _show_bell_menu() -> void:
	var unclaimed: int = GameManager.get_unclaimed_idle_faith() if GameManager else 0

	var hud = get_tree().root.find_child("GameHUD", true, false)
	if hud and hud.has_node("DialogueBox"):
		var db = hud.get_node("DialogueBox")
		if db.has_method("start_dialogue"):
			db.start_dialogue([
				{
					"speaker": "🔔 Sacred Bonshō Bell",
					"text": "The great bell resonates with pure spiritual clarity. What do you wish to invoke?"
				},
				{
					"speaker": "⛩️ Morning Prayer",
					"text": "[Press 1] Serenity Prayer: Restore party HP and advance to bright dawn."
				},
				{
					"speaker": "🚨 Midnight Alarm",
					"text": "[Press 2] Sound the Alarm: Summon the False Moon & repel the 3-wave Stigmata Siege!"
				},
				{
					"speaker": "🕊️ Rescued Soul Offerings",
					"text": "[Press 3] Claim %d Shrine Coins generated by rescued spirits." % unclaimed
				}
			])

	_is_ringing = false

func _unhandled_input(event: InputEvent) -> void:
	if not (event is InputEventKey and event.pressed and not event.echo):
		return

	# Allow player to select bell action using 1, 2, or 3 while near the bell
	if not is_instance_valid(interactable) or not ("_player_inside" in interactable and interactable._player_inside):
		return

	match event.physical_keycode:
		KEY_1:
			_invoke_serenity_prayer()
			get_viewport().set_input_as_handled()
		KEY_2:
			_start_midnight_siege()
			get_viewport().set_input_as_handled()
		KEY_3:
			_claim_idle_faith()
			get_viewport().set_input_as_handled()

func _invoke_serenity_prayer() -> void:
	if TimeManager:
		TimeManager.trigger_false_moon_eclipse(false)
		TimeManager.current_period = TimeManager.TimePeriod.DAY

	var player = get_tree().get_first_node_in_group("player")
	if player and player.has_node("StatsComponent"):
		var stats: StatsComponent = player.get_node("StatsComponent")
		stats.heal(stats.max_hp)

	_show_dialogue("✨ Serenity Prayer Answered", "The holy chime purifies all shadows. Your party is restored to full health, and peaceful sunlight warms Kamikitakuni!")

func _start_midnight_siege() -> void:
	if not GameManager or GameManager.is_shrine_siege_active:
		return

	GameManager.is_shrine_siege_active = true
	_siege_wave = 1

	if TimeManager:
		TimeManager.trigger_false_moon_eclipse(true)

	if CameraManager:
		CameraManager.shake(14.0, 0.5)

	_show_dialogue("🚨 MIDNIGHT SIEGE INCOMING!", "The bell's alarm warns the realm! Stigmata shadows are emerging from Route 1 to breach the Torii gate! Wave 1 begins!")
	call_deferred("_spawn_siege_wave", 1)

func _spawn_siege_wave(wave: int) -> void:
	_siege_alive_enemies = 0
	var enemy_count := 3 + (wave * 2) # Wave 1: 5, Wave 2: 7, Wave 3: 9

	for i in range(enemy_count):
		var chaser = CHASER_SCENE.instantiate()
		chaser.global_position = Vector2(860 + (i * 30), 860 + randf_range(-20, 20))
		if chaser.has_signal("defeated"):
			chaser.defeated.connect(_on_siege_enemy_defeated)
		get_parent().add_child(chaser)
		_siege_alive_enemies += 1

func _on_siege_enemy_defeated(_exp: int) -> void:
	_siege_alive_enemies = max(_siege_alive_enemies - 1, 0)
	if _siege_alive_enemies <= 0:
		if _siege_wave < 3:
			_siege_wave += 1
			_show_dialogue("⚔️ Wave Repelled!", "Wave %d cleared! Prepare for Wave %d!" % [_siege_wave - 1, _siege_wave])
			get_tree().create_timer(2.0).timeout.connect(func(): _spawn_siege_wave(_siege_wave))
		else:
			_victory_siege()

func _victory_siege() -> void:
	if not GameManager:
		return

	GameManager.is_shrine_siege_active = false
	if TimeManager:
		TimeManager.trigger_false_moon_eclipse(false)

	# Grand reward
	GameManager.shrine_coins += 300
	GameManager.add_character_shards("ookami_mio", 15)
	if EventBus:
		EventBus.currency_changed.emit(GameManager.shrine_coins)
	if AudioManager:
		AudioManager.play_sfx("purified")
	if SaveManager:
		SaveManager.save_game()

	_show_dialogue("🏆 SHRINE SIEGE VICTORIOUS!", "Kamikitakuni Shrine successfully defended against the midnight incursion! Received +300 Shrine Coins and +15 Awakening Shards!")

func _claim_idle_faith() -> void:
	if not GameManager:
		return
	var claimed := GameManager.claim_idle_faith()
	if claimed > 0:
		_show_dialogue("🕊️ Faith Gathered", "Collected +%d Shrine Coins from the prayers of rescued spirits residing at the shrine!" % claimed)
	else:
		_show_dialogue("🕊️ Faith Vessel Empty", "Rescued spirits are still praying. Explore routes and gyms to allow passive faith to accumulate!")

func _show_dialogue(speaker: String, text: String) -> void:
	var hud = get_tree().root.find_child("GameHUD", true, false)
	if hud and hud.has_node("DialogueBox"):
		var db = hud.get_node("DialogueBox")
		if db.has_method("start_dialogue"):
			db.start_dialogue([{
				"speaker": speaker,
				"text": text
			}])
